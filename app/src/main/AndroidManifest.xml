<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibración cuando la respuesta es incorrecta en ¿Mito o Realidad? -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Para guardar las partidas en la base de datos externa (Cloud Firestore). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Desde Android 11 hay que declarar que la app usa el lector de texto (voz de la intro). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TPJuego">
        <!-- Primera pantalla: ingreso con usuario y contraseña. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.TPJuego">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Intro, menú de juegos y resumen del usuario. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TPJuego" />

        <!-- Un juego por Activity. Se abren desde el menú con un Intent. -->
        <activity
            android:name=".MitoORealidadActivity"
            android:exported="false"
            android:theme="@style/Theme.TPJuego" />
        <activity
            android:name=".MemotestActivity"
            android:exported="false"
            android:theme="@style/Theme.TPJuego" />
        <activity
            android:name=".LaPreviaActivity"
            android:exported="false"
            android:theme="@style/Theme.TPJuego" />
    </application>

</manifest>
